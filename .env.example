# ═══════════════════════════════════════════════════════════════════════════════
# PROJECT GENESIS — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your system.
# Never commit the real .env file.

# ── Application ──
GENESIS_ENV=development
GENESIS_LOG_LEVEL=INFO
GENESIS_HOST=127.0.0.1
GENESIS_PORT=8000
GENESIS_SECRET_KEY=change-me-to-a-random-secret

# ── Data directories ──
GENESIS_DATA_DIR=d:/project_genesis/data
GENESIS_MODEL_DIR=d:/project_genesis/data/models
GENESIS_DATASET_DIR=d:/project_genesis/data/datasets
GENESIS_EXPERIMENT_DIR=d:/project_genesis/data/experiments
GENESIS_BACKUP_DIR=d:/project_genesis/data/backups

# ── Database ──
GENESIS_DB_URL=sqlite:///d:/project_genesis/data/genesis.db

# ── Model runtime ──
GENESIS_DEFAULT_BACKEND=ollama
GENESIS_DEFAULT_MODEL=
GENESIS_EMBEDDING_MODEL=

# ── Hardware hints (auto-detected if blank) ──
GENESIS_GPU_ENABLED=auto
GENESIS_MAX_RAM_GB=
GENESIS_MAX_VRAM_GB=

# ── Optional external services (local-first, disabled by default) ──
# GENESIS_OPENAI_API_KEY=
# GENESIS_ANTHROPIC_API_KEY=
